// tests.tc: in-game tests, printed to chat as WLTEST lines that
// tools/read_test.sh collects from the client log.
//   @wl test: the kernel and wire codec checks.
//   On join (players with developer or owner access): the codec checks, then
//   an end-to-end run of the desktop and its apps (the mouse checks turn the
//   player to aim the cursor, as looking around does), and the canvas card.
//   Deploying switches to play mode, which counts as joining, so every deploy
//   runs them.

/** Prints one WLTEST result: pass when got equals want. */
function wlCheck(name: str, got: any, want: any) {
    if (got == want) {
        allPlayers.sendMessage("WLTEST PASS %var(name)");
    } else {
        allPlayers.sendMessage("WLTEST FAIL %var(name): got %var(got), want %var(want)");
    }
}

/** @wl test: the codec checks, between WLTEST BEGIN and DONE. */
function wlSelfTest {
    allPlayers.sendMessage("WLTEST BEGIN");
    wlCodecChecks();
    allPlayers.sendMessage("WLTEST DONE");
}

/** Kernel and wire codec checks. */
function wlCodecChecks {
    wlInit();
    wlCheck("find space", global "wl.ascii".find(" "), 1);
    wlCheck("find tilde", global "wl.ascii".find("~"), 95);
    wlCheck("int -5", wlInt(-5), 4294967291);
    wlCheck("signed", wlSigned(4294967291), -5);
    wlCheck("byte 3", wlByte(4278255360, 3), 255);
    wlCheck("byte 1", wlByte(4278255360, 1), 255);
    wlCheck("byte 0", wlByte(4278255360, 0), 0);
    line sw: list[num] = wlStrWords("wl_shm");
    wlCheck("str words", sw.len(), 3);
    wlCheck("str back", wlStrAt(sw, 1), "wl_shm");
    line sw4: list[num] = wlStrWords("abcd");
    wlCheck("str4 words", sw4.len(), 3);
    wlCheck("str4 back", wlStrAt(sw4, 1), "abcd");
    line words: list[num] = wlEncode("req", "wl_registry", 2, "bind", [3, "xdg_wm_base", 1, 7]);
    line frames: list = wlFrames(words);
    wlCheck("frames", frames.len(), 1);
    line fr: list = frames[1] as list;
    wlCheck("frame obj", fr[1], 2);
    wlCheck("frame op", fr[2], 0);
    line args: list = wlDecode(wlSpec("req", "wl_registry", 0), fr[3] as list[num]);
    wlCheck("bind name", args[1], 3);
    wlCheck("bind iface", args[2], "xdg_wm_base");
    wlCheck("bind version", args[3], 1);
    wlCheck("bind id", args[4], 7);
    line ev: list[num] = wlEncode("ev", "wl_pointer", 9, "motion", [1234, 12.5, -3]);
    line evf: list = wlFrames(ev)[1] as list;
    line eva: list = wlDecode(wlSpec("ev", "wl_pointer", evf[2] as num), evf[3] as list[num]);
    wlCheck("fixed x", eva[2], 12.5);
    wlCheck("fixed y", eva[3], -3);
    line two: list[num] = words;
    two.appendList(ev);
    wlCheck("two frames", wlFrames(two).len(), 2);
    line fd: num = kMemCreate(100);
    wlCheck("memfd words", global "k.mem %var(fd)".len(), 25);
    kMemFree(fd);
}

/** Where the join tests' player stood: eye location and UUID. */
declare global "test.eye": loc;
declare global "test.player": str;

/** Prints a WLTEST result for a condition already reduced to 1 (true) or 0. */
function wlCheckTrue(name: str, ok: num) {
    wlCheck(name, ok, 1);
}

/** Starts the join tests for this player: they are seated at the desktop. */
function wlAutoStart {
    global "test.eye" = default.eyeLocation;
    wmStart();
    global "test.player" = default.uuid;
    start wlAutoTest;
}

/** Mapped windows. */
function wtWindows(): num {
    if (!var.exists(global "s.windows")) {
        return 0;
    }
    return global "s.windows".len();
}

/** Windows with bands still to render or a commit not yet presented. */
function wtPending(): num {
    line n: num = 0;
    for (line key of global "s.windows") {
        line p: list = (key as str).split(":");
        line c: num = num.parse(p[1] as str);
        line id: num = num.parse(p[2] as str);
        if ((wlsGet(c, id, "dirty") as list).len() > 0 || wlsGet(c, id, "present") as num == 1) {
            n += 1;
        }
    }
    return n;
}

/** The window key of app `name` (its wlcConnect name), or "". */
function wtWindow(name: str): str {
    for (line key of global "s.windows") {
        line c: str = (key as str).split(":")[1] as str;
        if (global "k.names".hasKey(c) && global "k.names"[c] as str == name) {
            return key as str;
        }
    }
    return "";
}

/** The memfd of window key's current buffer. */
function wtFd(key: str): num {
    line p: list = key.split(":");
    line c: num = num.parse(p[1] as str);
    line id: num = num.parse(p[2] as str);
    line buf: num = wlsGet(c, id, "buf") as num;
    return wlsGet(c, buf, "fd") as num;
}

/** 1 if window key's p15 buffer shows text on one of its 8-pixel text rows, as the terminal draws it at the window's size. */
function wtTermShows(key: str, text: str): num {
    line fd: num = wtFd(key);
    line w: num = wtGet(key, "w");
    line cols: num = num.floor(w / 8);
    line bg: str = p15Color(0x101018);
    line padded: str = text + " ".repeat(cols);
    line want: list[str] = p15TextRows(padded.trim(1, cols), p15Patterns(p15Color(0xD0D0C0), bg));
    line rest: str = "";
    if (w > cols * 8) {
        rest = bg.repeat(w - cols * 8);
    }
    repeat (line r to num.floor(wtGet(key, "h") / 8)) {
        line same: num = 1;
        repeat (line i to 8) {
            if (global "k.mem %var(fd)"[(r - 1) * 8 + i] as str != (want[i] as str) + rest) {
                same = 0;
            }
        }
        if (same == 1) {
            return 1;
        }
    }
    return 0;
}

/** A number from window key's state (w, h, wx, wy, ...). */
function wtGet(key: str, field: str): num {
    line p: list = key.split(":");
    return wlsGet(num.parse(p[1] as str), num.parse(p[2] as str), field) as num;
}

/** Points the test player's cursor at canvas (x, y), as looking there does (4 pixels per degree), and lets wmInput see it. */
function wtAim(x: num, y: num) {
    select playersByName(global "test.player");
    selected.setRotation(y / 4, x / 4);
    select reset;
    wait(3);
}

/** A left click where the cursor is, then a few ticks for the compositor to act on it. */
function wtClick {
    global "s.clicks".append(272);
    wait(3);
}

/** Waits up to `ticks` ticks for window key to have width w. */
function wtWaitWidth(key: str, w: num, ticks: num) {
    line waited: num = 0;
    while (wtGet(key, "w") != w && waited < ticks) {
        wait;
        waited += 1;
    }
}

/** Waits up to `ticks` ticks for wtWindows() to reach n. */
function wtWaitWindows(n: num, ticks: num) {
    line waited: num = 0;
    while (wtWindows() != n && waited < ticks) {
        wait;
        waited += 1;
    }
}

/** The join tests: codec checks, the compositor and its apps end to end, and the canvas card. */
process wlAutoTest {
    allPlayers.sendMessage("WLTEST BEGIN");
    wlCodecChecks();

    // The desktop: the player is seated and the cursor is up.
    select playersByName(global "test.player");
    line seated: num = 0;
    if (selected.isRidingEntity()) {
        seated = 1;
    }
    select reset;
    wlCheckTrue("desk player seated", seated);
    line hasCursor: num = 0;
    if (global "s.desk"["cursor"] as str != "") {
        hasCursor = 1;
    }
    wlCheckTrue("desk cursor", hasCursor);

    // A bare client sees the five globals and the p15 format.
    line c: num = wlcConnect("e2e");
    wlcRoundtrip(c);
    wlCheck("e2e globals", global "cl.globals %var(c)".len(), 5);
    line shm: num = wlcBind(c, "wl_shm", 1);
    wlcRoundtrip(c);
    line hasP15: num = 0;
    for (line ev of wlcPoll(c)) {
        line e: list = ev as list;
        if (e[3] as str == "format" && (e[4] as list)[1] as num == p15Format()) {
            hasP15 = 1;
        }
    }
    wlCheck("e2e shm offers p15", hasP15, 1);
    wlcClose(c);

    // The apps map their windows and the compositor presents them.
    appLaunch("simple");
    appLaunch("paint");
    appLaunch("terminal");
    wtWaitWindows(3, 400);
    wlCheck("e2e three windows mapped", wtWindows(), 3);
    line waited: num = 0;
    while (wtPending() > 0 && waited < 200) {
        wait;
        waited += 1;
    }
    wlCheck("e2e windows presented", wtPending(), 0);

    // Keyboard: a typed line reaches the terminal, which echoes it.
    line term: str = wtWindow("terminal");
    line found: num = 0;
    if (term != "") {
        found = 1;
    }
    wlCheckTrue("e2e terminal found", found);
    if (term != "") {
        wmFocus(term);
        kbQueueLine("echo hi");
        wait(30);
        wlCheck("e2e terminal echo", wtTermShows(term, "hi"), 1);
    }

    // Pointer: a click paints a red dot where the pointer is.
    line paint: str = wtWindow("paint");
    found = 0;
    if (paint != "") {
        found = 1;
    }
    wlCheckTrue("e2e paint found", found);
    if (paint != "") {
        line pid: num = num.parse(paint.split(":")[2] as str);
        wmPointerEvent(paint, "enter", [wlsSerial(), pid, 10, 20]);
        wmPointerEvent(paint, "button", [wlsSerial(), wlsTime(), 272, 1]);
        wmPointerEvent(paint, "button", [wlsSerial(), wlsTime(), 272, 0]);
        wait(20);
        line pfd: num = wtFd(paint);
        line prow: str = (global "k.mem %var(pfd)" as list)[21] as str;
        line px: str = prow.trim(11, 11);
        line red: num = 0;
        if (px == p15Color(0xE02020)) {
            red = 1;
        }
        wlCheckTrue("e2e paint dot", red);

        // Hit tests: the parts of the window under the pointer (raised, so the terminal doesn't cover it).
        wmFocus(paint);
        line wx: num = wtGet(paint, "wx");
        line wy: num = wtGet(paint, "wy");
        line w: num = wtGet(paint, "w");
        line h: num = wtGet(paint, "h");
        wlCheck("hit body", wmHit(wx + 20, wy + 20)[2], "body");
        wlCheck("hit grip", wmHit(wx + w - 2, wy + h - 2)[2], "grip");
        wlCheck("hit title", wmHit(wx + 20, wy - 5)[2], "title");
        wlCheck("hit close", wmHit(wx + w - 4, wy - 5)[2], "close");

        // Mouse: aim at the title bar, click, aim 40 right and 20 down, click: the window moves.
        wtAim(wx + 20, wy - 5);
        wlCheck("cursor follows look", global "s.ptr"["x"], wx + 20);
        wtClick();
        wtAim(wx + 60, wy + 15);
        wtClick();
        wlCheck("drag moves x", wtGet(paint, "wx"), wx + 40);
        wlCheck("drag moves y", wtGet(paint, "wy"), wy + 20);
        wx = wtGet(paint, "wx");
        wy = wtGet(paint, "wy");

        // Resize: click the grip, aim 20 right and 10 down, click: the client takes the new size.
        wtAim(wx + w - 3, wy + h - 3);
        wtClick();
        wlCheck("resize mode", global "s.ptr"["resize"], paint);
        wtAim(wx + w + 17, wy + h + 7);
        // Holds the outline on screen for 3 seconds, long enough to see it.
        allPlayers.sendMessage("WLTEST NOTE resize outline up");
        wait(60);
        wtClick();
        wtWaitWidth(paint, w + 18, 100);
        wlCheck("resize width", wtGet(paint, "w"), w + 18);
        wlCheck("resize height", wtGet(paint, "h"), h + 8);
        pfd = wtFd(paint);
        prow = (global "k.mem %var(pfd)" as list)[21] as str;
        line kept: num = 0;
        if (prow.trim(11, 11) == p15Color(0xE02020) && prow.len() == w + 18) {
            kept = 1;
        }
        wlCheckTrue("resize keeps the picture", kept);
    }

    // The terminal reflows to a new size and still shows its text.
    if (term != "") {
        wmResizeTo(term, 160, 104);
        wtWaitWidth(term, 160, 100);
        wlCheck("terminal resized", wtGet(term, "w"), 160);
        wait(10);
        wlCheck("terminal redraws after resize", wtTermShows(term, "hi"), 1);
    }

    // simple redraws on every frame callback, so its rows change.
    line simple: str = wtWindow("simple");
    found = 0;
    if (simple != "") {
        found = 1;
    }
    wlCheckTrue("e2e simple found", found);
    if (simple != "") {
        line sfd: num = wtFd(simple);
        line before: str = (global "k.mem %var(sfd)" as list[str]).join("");
        wait(10);
        line after: str = (global "k.mem %var(sfd)" as list[str]).join("");
        line moved: num = 0;
        if (before != after) {
            moved = 1;
        }
        wlCheckTrue("e2e simple animates", moved);
        // The close box: the client exits and its window goes.
        line sp: list = simple.split(":");
        line sc: num = num.parse(sp[1] as str);
        line sid: num = num.parse(sp[2] as str);
        wlsSend(sc, wlsGet(sc, sid, "top") as num, "xdg_toplevel", "close", list.create());
        wtWaitWindows(2, 100);
        wlCheck("e2e simple closed", wtWindows(), 2);
    }
    wmStop();

    // Canvas: the card's size, every band under DF's 10,000-character limit,
    // then the card on screen for 5 seconds.
    line rows: list[str] = scrCard(480, 270);
    wlCheck("canvas rows", rows.len(), 270);
    wlCheck("canvas row width", (rows[135] as str).len(), 480);
    scrStart(480, 270, 8, 0, global "test.eye" as loc, global "test.player" as str);
    line longest: num = 0;
    repeat (line b to global "scr.cfg"["bands"] as num) {
        longest = num.max(longest, scrBandText(rows, b).len());
    }
    line fits: num = 0;
    if (longest < 10000) {
        fits = 1;
    }
    wlCheckTrue("canvas bands under 10000 chars", fits);
    wait(100);
    scrStop();
    allPlayers.sendMessage("WLTEST DONE");
}

// font.tc: drawing into p15 images, the way a client toolkit would. A p15
// image (wl_shm format P15, see README) is a shared-memory file whose list
// holds one string per pixel row: one wl:p15 glyph (an rgb555 pixel) per
// character. Rows are edited as strings, so drawing costs one splice per
// row, and the compositor sends rows without converting them.
//
// Text uses the 8x8 font (font8.tc): for each color pair a table maps every
// font row byte to its 8-glyph string.

/** 8x8 font rows (font8.tc). */
declare global "font.rows": list[num];
/** wl:p15 glyph table: 8 strings of 4096 glyphs, value v at chunk v >> 12, position (v & 4095) + 1. */
declare global "p15.s %var(k)": str;
/** Row-byte tables by color pair ("<fg> <bg>"): 256 strings of 8 glyphs each. */
declare global "p15.pat": dict;

/** The wl_shm format code for p15 rows ("DF15"). */
function p15Format(): num {
    return 892421700;
}

/** Loads the font rows and the p15 glyph table, once. */
function fontInit {
    if (!var.exists(global "font.rows")) {
        global "font.rows" = fontRows();
    }
    if (!var.exists(global "p15.pat")) {
        repeat (line k to 8) {
            line chunk: num = k - 1;
            global "p15.s %var(chunk)" = p15Chunk(chunk);
        }
        global "p15.pat" = {};
    }
}

/** The p15 glyph for rgb555 value v (0-32767). */
function p15Glyph(v: num): str {
    line i: num = v & 4095;
    line chunk: num = v >> 12;
    return (global "p15.s %var(chunk)" as str).trim(i + 1, i + 1);
}

/** The p15 glyph closest to 24-bit color c (0xRRGGBB). */
function p15Color(c: num): str {
    return p15Glyph(((c >> 19) & 31) * 1024 + ((c >> 11) & 31) * 32 + ((c >> 3) & 31));
}

/** Makes a p15 image of h rows of w copies of glyph g; returns its fd. */
function p15Create(w: num, h: num, g: str): num {
    line fd: num = kMemCreate(4);
    line row: str = g.repeat(w);
    line rows: list[str] = list.create() as list[str];
    repeat (h) {
        rows.append(row);
        cpuGuard();
    }
    global "k.mem %var(fd)" = rows;
    return fd;
}

/** row with `piece` written over it from glyph x (0-based); the row keeps its length. */
function p15Splice(row: str, x: num, piece: str): str {
    line n: num = row.len();
    line end: num = num.min(n, x + piece.len());
    if (x >= n || end <= x) {
        return row;
    }
    line out: str = "";
    if (x > 0) {
        out = row.trim(1, x);
    }
    out = out + piece.trim(1, end - x);
    if (end < n) {
        out = out + row.trim(end + 1, n);
    }
    return out;
}

/** Fills the rectangle x, y, w x h of image fd with glyph g. */
function p15Fill(fd: num, x: num, y: num, w: num, h: num, g: str) {
    line piece: str = g.repeat(w);
    repeat (line r to h) {
        line idx: num = y + r;
        global "k.mem %var(fd)"[idx] = p15Splice(global "k.mem %var(fd)"[idx] as str, x, piece);
        cpuGuard();
    }
}

/** The row-byte table for glyphs fg (set bits) and bg: 256 strings of 8 glyphs, the leftmost for bit 7. */
function p15Patterns(fg: str, bg: str): list[str] {
    line key: str = "%var(fg) %var(bg)";
    if (global "p15.pat".hasKey(key)) {
        return global "p15.pat"[key] as list[str];
    }
    line out: list[str] = list.create() as list[str];
    repeat (line n to 256) {
        line bits: num = n - 1;
        line s: str = "";
        repeat (line k to 8) {
            if (((bits >> (8 - k)) & 1) == 1) {
                s = s + fg;
            } else {
                s = s + bg;
            }
        }
        out.append(s);
        cpuGuard();
    }
    global "p15.pat"[key] = out;
    return out;
}

/** The 8 pixel-row strings of `text` in the 8x8 font, 8 glyphs per character. */
function p15TextRows(text: str, pat: list[str]): list[str] {
    line rows: list[str] = list.create() as list[str];
    repeat (line r to 8) {
        line parts: list[str] = list.create() as list[str];
        repeat (line i to text.len()) {
            line code: num = global "wl.ascii".find(text.trim(i, i));
            if (code < 1) {
                code = 1;
            }
            parts.append(pat[(global "font.rows"[(code - 1) * 8 + r] as num) + 1] as str);
        }
        rows.append(parts.join(""));
        cpuGuard();
    }
    return rows;
}

/** Draws text with its top-left at pixel (x, y), 8 pixels per character, in glyphs fg on bg. */
function p15Text(fd: num, x: num, y: num, text: str, fg: str, bg: str) {
    line rows: list[str] = p15TextRows(text, p15Patterns(fg, bg));
    repeat (line r to 8) {
        line idx: num = y + r;
        global "k.mem %var(fd)"[idx] = p15Splice(global "k.mem %var(fd)"[idx] as str, x, rows[r] as str);
    }
}

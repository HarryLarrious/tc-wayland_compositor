/** Program `name`'s image as chunks of encoded words, or [] if there is no such program. */
function rvImage(name: str): list[str] {
    if (name == "bench") {
        return rvImg_bench();
    } else if (name == "hello") {
        return rvImg_hello();
    } else if (name == "isa") {
        return rvImg_isa();
    } else if (name == "window") {
        return rvImg_window();
    }
    return list.create() as list[str];
}

/** What program `name` prints, from the reference emulator (tools/rvemu.py); "" if it has none. */
function rvExpect(name: str): str {
    if (name == "bench") {
        return "primes below 3000: 430\ninstructions: 49065\n";
    } else if (name == "hello") {
        return "hello from RISC-V on DiamondFire\nfib(15) = 610\n";
    } else if (name == "isa") {
        return "add 76b0d113\nsub d258f453\nsll 9f100978\nslt a1df843c\nsltu 8a582fec\nxor b5b354c5\nsrl 307c544f\nsra 0da9962f\nor a4b6a9c6\nand 95f74b3e\nmul a018efb0\nmulh a6ab044b\nmulhsu eb57d2a9\nmulhu 56362145\ndiv 4643a341\ndivu a97f1a79\nrem ab7a6796\nremu b54b3c22\nmem d466c406\n";
    }
    return "";
}

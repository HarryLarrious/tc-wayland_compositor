// wm.tc: the window manager: a desktop locked to the screen. The player who
// runs @wl start sits on an invisible seat facing yaw 0. Every window, title
// bar, resize grip and the cursor is a text display at their eye, which the
// text shader places on a canvas over the whole window (text.vsh, screen
// canvas): 360 canvas pixels tall, (0, 0) at the screen centre, x right and
// y down. A display's translation (in blocks, 40 canvas pixels each) puts it
// on the canvas, and its z stacks windows.
//
// The player's look direction is the mouse: 4 canvas pixels per degree of
// yaw and pitch, the same mapping the shader uses to draw the cursor sprite,
// so the server's hit tests agree with what is drawn. Left and right clicks
// are buttons; chat lines are typed into the focused window (keymap.tc).
//
// Window management: click a window to focus and raise it; click its title
// bar to pick it up and click again to drop it; click the red box to close
// it; click the grip at its bottom-right corner, move, and click again to
// resize it (the client gets xdg_toplevel.configure with the new size).
//
// The desktop shell (shell.tc) is a client too. Through df_shell
// (protocol/df-shell.xml) it puts up panels, surfaces with no title bar that
// stay where their role puts them: the background (one color, stretched
// under every window), the taskbar and the start menu (above every
// window). It is told about every window by handle, and can activate,
// minimize and close windows and launch apps.

/** Window keys "<c>:<surface id>", bottom to top. */
declare global "s.windows": list[str];
/** UUID of the player whose look and clicks drive the pointer. */
declare global "s.player": str;
/** The desktop: eye (display location), seat, cursor and outline (4 edge display UUIDs: top, bottom, left, right). */
declare global "s.desk": dict;
/**
 * Pointer state: x, y (canvas, from the centre), over (window key under the
 * pointer or ""), sx, sy (surface position), drag and ddx, ddy (window
 * being moved and the grab offset), resize, rw, rh (window being resized and
 * its new size).
 */
declare global "s.ptr": dict;
/** Window key with keyboard focus, or "". */
declare global "s.focus": str;
/** Buttons clicked since the last tick (evdev codes). */
declare global "s.clicks": list[num];
/** Keys typed since the last tick: [code, shift] pairs. */
declare global "s.keys": list;
/** Windows mapped so far (places the next one). */
declare global "s.placed": num;
/** Mapped panel keys "<c>:<surface id>" (shell surfaces: background, taskbar, menu). */
declare global "s.panels": list[str];
/** df_shell bindings "<c>:<id>", told about every window. */
declare global "s.shells": list[str];
/** The last window handle given out, and window key by handle (as text). */
declare global "s.handle": num;
declare global "s.handles": dict;
/** 1 when the windows changed since the shells were last told; the handles they were told about. */
declare global "s.shellDirty": num;
declare global "s.shellSent": list[num];

/** Title bar height in canvas pixels. */
function wmDecoH(): num {
    return 10;
}

/** Canvas size the server assumes (16:9; the shader widens it to the window's aspect). Also the output's mode. */
function wmCanvasW(): num {
    return 640;
}

function wmCanvasH(): num {
    return 360;
}

/** Resize grip size in canvas pixels, and the smallest and largest window sizes. */
function wmGrip(): num {
    return 8;
}

function wmMinW(): num {
    return 48;
}

function wmMinH(): num {
    return 32;
}

/** Taskbar height in canvas pixels. */
function wmTaskbarH(): num {
    return 12;
}

/** Stacking depth (text.vsh: 0 to 0.1, larger is nearer) of the windows' top and of each panel role: background, taskbar, menu. */
function wmTopZ(): num {
    return 0.08;
}

function wmPanelZ(role: num): num {
    return [0, 0.09, 0.095][role + 1] as num;
}

/** The size df_panel.configure gives a panel role; 0 x 0 lets the client choose. */
function wmPanelSize(role: num): list[num] {
    if (role == 0) {
        return [wmCanvasW(), wmCanvasH()];
    } else if (role == 1) {
        return [wmCanvasW(), wmTaskbarH()];
    }
    return [0, 0];
}

/** The color tag that marks canvas text: kind "a5" window, "a6" sprite (black is clear), "a7" cursor, "a8" full-width strip. Green is half the canvas height. */
function wmMark(kind: str): str {
    line half: str = global "px.hex"[wmCanvasH() / 2 + 1] as str;
    return "<font:wl:p15><c:#fa%var(half)%var(kind)>";
}

/** Starts the compositor: seats the player facing yaw 0 and puts the cursor up. */
function wmStart {
    wlInit();
    kbInit();
    fontInit();
    pxInit();
    wmStop();
    global "s.player" = default.uuid;
    // The seat sits at block fraction 0.123 in x and 0.456 in z: shaders read
    // the camera's fraction as the desktop flag (wl:desktop.glsl) and hide
    // the hand and hotbar.
    line here: loc = default.location;
    game.spawnInteractionEntity(loc(num.floor(here.x) + 0.123, here.y, num.floor(here.z) + 0.456, 0, 0), 0.8, 0.6);
    line seat: str = lastEntity.uuid;
    default.rideEntity(seat);
    default.setRotation(0, 0);
    // Let the riding pose settle before reading the eye position.
    wait(2);
    line e: loc = default.eyeLocation;
    global "s.desk" = {eye: loc(e.x, e.y, e.z, 0, 0), seat: seat, cursor: "", outline: list.create()};
    // A display's text is centred on it and sits above it: shift the 8 x 12
    // arrow right by half its width and down by its height, so its tip (not
    // its base) is on the look point.
    global "s.desk"["cursor"] = wmSprite(wmCursorText(), "a7", 4, 12, 0);
    line outline: list[str] = list.create() as list[str];
    repeat (4) {
        outline.append(wmSprite(" ", "a6", 0, 0, 0.1));
    }
    global "s.desk"["outline"] = outline;
    global "s.ptr" = {x: 0, y: 0, over: "", sx: 0, sy: 0, drag: "", ddx: 0, ddy: 0, resize: "", rw: 0, rh: 0};
    global "s.focus" = "";
    global "s.clicks" = list.create() as list[num];
    global "s.keys" = list.create();
    global "s.windows" = list.create() as list[str];
    global "s.conns" = list.create() as list[num];
    global "s.placed" = 0;
    global "s.panels" = list.create() as list[str];
    global "s.shells" = list.create() as list[str];
    global "s.handle" = 0;
    global "s.handles" = {};
    global "s.shellDirty" = 0;
    global "s.shellSent" = list.create() as list[num];
    if (!var.exists(global "shell.bg")) {
        global "shell.bg" = 0x000000;
    }
    global "k.listen" = list.create() as list[num];
    global "k.closed" = list.create() as list[num];
    start wlServer;
    start appShell;
}

/** Stops the compositor and every client, removes every window and the cursor, and lets the player off the seat. */
function wmStop {
    global "wl.alive" += 1;
    global "s.on" = 0;
    if (var.exists(global "s.windows")) {
        line windows: list[str] = global "s.windows";
        for (line key of windows) {
            line parts: list = (key as str).split(":");
            wmRemoveDisplays(num.parse(parts[1] as str), num.parse(parts[2] as str));
        }
    }
    global "s.windows" = list.create() as list[str];
    if (var.exists(global "s.panels")) {
        line panels: list[str] = global "s.panels";
        for (line key of panels) {
            line pp: list = (key as str).split(":");
            wmRemoveDisplays(num.parse(pp[1] as str), num.parse(pp[2] as str));
        }
    }
    global "s.panels" = list.create() as list[str];
    if (var.exists(global "s.desk")) {
        line desk: dict = global "s.desk";
        line ents: list[str] = desk["outline"] as list[str];
        ents.append(desk["cursor"] as str, desk["seat"] as str);
        if (var.exists(global "s.player")) {
            select playersByName(global "s.player");
            selected.rideEntity();
            select reset;
        }
        for (line uid of ents) {
            select entitiesByUUID(uid as str);
            selectedEntity.remove();
            select reset;
        }
        var.purgeMatching("s.desk", matchRequirement="Entire name");
    }
}

/** 1 while the compositor runs. A mode switch ends processes without running @wl stop, so the loop's heartbeat decides. */
function wmActive(): num {
    if (var.exists(global "s.on") && global "s.on" == 1 && var.exists(global "s.beat") && game.ticksSinceStartup - global "s.beat" < 40) {
        return 1;
    }
    return 0;
}

/** Spawns a canvas display at the desk's eye: p15 text in canvas `kind`, translated to (x, y) canvas pixels at stacking z. Returns its UUID. */
function wmSprite(text: str, kind: str, x: num, y: num, z: num): str {
    game.spawnTextDisplay(global "s.desk"["eye"] as loc, s" ");
    wmSetupDisplay(2000, 1);
    lastEntity.setDisplayTranslation(x / 40, 0 - y / 40, z);
    line uid: str = lastEntity.uuid;
    wmSetText(uid, wmMark(kind) + text);
    return uid;
}

/** Sets up the display just spawned (lastEntity) for the canvas: a p15 glyph (2 x 10 font units) becomes one canvas pixel. */
function wmSetupDisplay(lineWidth: num, rows: num) {
    lastEntity.setDisplayBillboard(type="Fixed");
    lastEntity.setDisplayScale(0.5, 0.1, 0.1);
    lastEntity.setTextDisplayLineWidth(lineWidth);
    lastEntity.setTextDisplayTextAlignment(align="Left");
    lastEntity.setTextDisplayBackground("#000000", 0);
    lastEntity.setTextDisplayTextShadow(textShadow="Disable");
    // 0 x 0 turns culling off: the display sits at the eye.
    lastEntity.setDisplayCullingSize(0, 0);
}

/** The cursor: an arrow with its tip at the top-left, white with a dark outline; pure black is clear. */
function wmCursorText(): str {
    line art: list[str] = ["X.......", "XX......", "XWX.....", "XWWX....", "XWWWX...", "XWWWWX..", "XWWWWWX.", "XWWWWWWX", "XWWWXXXX", "XWXWX...", "XX.XWX..", "X...XX.."];
    line rows: list[str] = list.create() as list[str];
    for (line r of art) {
        rows.append((r as str).replace(".", p15Glyph(0)).replace("X", p15Color(0x080808)).replace("W", p15Color(0xFFFFFF)));
    }
    return rows.join("\n");
}

/** Translation (blocks) that puts a w x rows text's top-left at canvas (x, y): text is centred on its display and sits above it. */
function wmAt(x: num, y: num, w: num, rows: num, z: num): vec {
    return vec((x + w / 2) / 40, 0 - (y + rows) / 40, z);
}

/** Moves display uid to translation t. */
function wmMove(uid: str, t: vec) {
    select entitiesByUUID(uid);
    selectedEntity.setDisplayTranslation(t);
    select reset;
}

/** Sets display uid's text, parsed as MiniMessage. */
function wmSetText(uid: str, text: str) {
    select entitiesByUUID(uid);
    selectedEntity.setTextDisplayText(txt.parseExpression(text, allowed="Full"));
    select reset;
}

/** Shows (maps or updates) surface id of c with its committed buffer; damage is [x, y, w, h, ...]. */
function wmShow(c: num, id: num, damage: list) {
    line buf: num = wlsGet(c, id, "buf") as num;
    line b: dict = global "s.o %var(c) %var(buf)" as dict;
    line w: num = b["width"] as num;
    line h: num = b["height"] as num;
    line format: num = b["format"] as num;
    line st: dict = global "s.o %var(c) %var(id)";
    line key: str = "%var(c):%var(id)";
    line panel: num = 0;
    if (st["role"] as str == "panel") {
        panel = 1;
    }
    line fresh: num = 0;
    if (st["mapped"] as num == 0 || st["w"] as num != w || st["h"] as num != h || st["format"] as num != format) {
        if (st["mapped"] as num == 1) {
            wmRemoveDisplays(c, id);
        } else if (panel == 1) {
            global "s.panels".append(key);
        } else {
            // A new window: cascade it down from upper left of centre and give it focus.
            st["wx"] = -240 + (global "s.placed" * 40) % 240;
            st["wy"] = -140 + (global "s.placed" * 30) % 150;
            global "s.placed" += 1;
            global "s.windows".append(key);
            global "s.handle" += 1;
            line handle: num = global "s.handle";
            st["handle"] = handle;
            st["min"] = 0;
            global "s.handles"["%var(handle)"] = key;
            global "s.shellDirty" = 1;
        }
        st["mapped"] = 1;
        st["w"] = w;
        st["h"] = h;
        st["format"] = format;
        st["cols"] = w;
        // About 1024 glyphs a band: every change re-sends its whole band, and the
        // client re-processes each glyph sent (README, Data path benchmarks).
        st["bandRows"] = num.max(1, num.min(num.floor(1024 / w), num.floor(9980 / (w + 1))));
        st["bands"] = num.round(h / (st["bandRows"] as num), mode="Ceiling");
        if (panel == 1 && st["panel"] as num == 0) {
            // The background is all fill (wmFillText).
            st["bands"] = 0;
        }
        global "s.o %var(c) %var(id)" = st;
        wmCreateDisplays(c, id);
        fresh = 1;
    }
    // Damaged rows mark their bands for rendering.
    line dirty: list[num] = list.create() as list[num];
    if ((global "s.o %var(c) %var(id)").hasKey("dirty")) {
        dirty = wlsGet(c, id, "dirty") as list[num];
    }
    line bandRows: num = wlsGet(c, id, "bandRows") as num;
    line bands: num = wlsGet(c, id, "bands") as num;
    if (fresh == 1) {
        damage = [0, 0, w, h];
    }
    line i: num = 1;
    while (i + 3 <= damage.len()) {
        cpuGuard();
        line y0: num = num.max(0, damage[i + 1] as num);
        line y1: num = num.min(h - 1, (damage[i + 1] as num) + (damage[i + 3] as num) - 1);
        if (y1 >= y0) {
            repeat (line band to bands) {
                line top: num = (band - 1) * bandRows;
                if (top <= y1 && top + bandRows - 1 >= y0 && dirty.find(band) == 0) {
                    dirty.append(band);
                }
            }
        }
        i += 4;
    }
    wlsPut(c, id, "dirty", dirty);
    wlsPut(c, id, "present", 1);
    if (panel == 1 && st["panel"] as num <= 1) {
        wmSetText(wlsGet(c, id, "fill") as str, wmFillText(c, id));
    }
    if (fresh == 1 && panel == 0) {
        wmFocus(key);
    }
}

/** Spawns window id's band displays, title bar and resize grip at the eye. */
function wmCreateDisplays(c: num, id: num) {
    line st: dict = global "s.o %var(c) %var(id)";
    line w: num = st["w"] as num;
    line uuids: list[str] = list.create() as list[str];
    repeat (st["bands"] as num) {
        cpuGuard();
        game.spawnTextDisplay(global "s.desk"["eye"] as loc, s" ");
        wmSetupDisplay(w * 2 + 10, st["bandRows"] as num);
        uuids.append(lastEntity.uuid);
    }
    wlsPut(c, id, "displays", uuids);
    if (st["role"] as str == "panel") {
        wlsPut(c, id, "decoDirty", 0);
        if (st["panel"] as num <= 1) {
            // The background, and the taskbar's ends on wide windows: a full-width strip.
            game.spawnTextDisplay(global "s.desk"["eye"] as loc, s" ");
            wmSetupDisplay(20, wmCanvasH());
            wlsPut(c, id, "fill", lastEntity.uuid);
        }
        wmPlace(c, id);
        return;
    }
    game.spawnTextDisplay(global "s.desk"["eye"] as loc, s" ");
    wmSetupDisplay(w * 2 + 10, wmDecoH());
    wlsPut(c, id, "deco", lastEntity.uuid);
    wlsPut(c, id, "grip", wmSprite(wmGripText(), "a6", 0, 0, 0));
    // The title bar is a small p15 image the compositor draws itself.
    wlsPut(c, id, "decoFd", p15Create(w, wmDecoH(), p15Color(0)));
    wmDrawDeco(c, id);
    wmPlace(c, id);
}

/** The resize grip: three diagonal ridges in the bottom-right corner; pure black is clear. */
function wmGripText(): str {
    line clear: str = p15Glyph(0);
    line ridge: str = p15Color(0xC0C0C0);
    line rows: list[str] = list.create() as list[str];
    repeat (line y to wmGrip()) {
        line row: str = "";
        repeat (line x to wmGrip()) {
            // Ridges where x + y hits 7, 10 and 13 (0-based), on the lower-right half.
            line s: num = (x - 1) + (y - 1);
            if (s == 7 || s == 10 || s == 13) {
                row = row + ridge;
            } else {
                row = row + clear;
            }
        }
        rows.append(row);
    }
    return rows.join("\n");
}

/**
 * Where surface id's buffer goes: [x, y, sx, sy, z], its top-left in canvas
 * pixels, each buffer pixel covering sx x sy, at stacking depth z.
 * Windows sit where they were put (far off the canvas while minimized);
 * panels where their role says. The background covers the whole canvas.
 */
function wmBox(c: num, id: num): list[num] {
    line st: dict = global "s.o %var(c) %var(id)";
    line w: num = st["w"] as num;
    line h: num = st["h"] as num;
    if (st["role"] as str == "panel") {
        line role: num = st["panel"] as num;
        if (role == 0) {
            return [0 - wmCanvasW() / 2, 0 - wmCanvasH() / 2, wmCanvasW() / w, wmCanvasH() / h, wmPanelZ(0)];
        } else if (role == 1) {
            return [0 - wmCanvasW() / 2, wmCanvasH() / 2 - h, 1, 1, wmPanelZ(1)];
        }
        return [0 - wmCanvasW() / 2, wmCanvasH() / 2 - wmTaskbarH() - h, 1, 1, wmPanelZ(2)];
    }
    // Each step up the stack is nearer the camera (text.vsh: z 0 to 0.1).
    line z: num = num.min(global "s.windows".find("%var(c):%var(id)") * 0.003, wmTopZ());
    line x: num = st["wx"] as num;
    if (st["min"] as num == 1) {
        x += 20000;
    }
    return [x, st["wy"] as num, 1, 1, z];
}

/** Moves surface id's displays to its canvas position and stacking depth. */
function wmPlace(c: num, id: num) {
    line st: dict = global "s.o %var(c) %var(id)";
    line box: list[num] = wmBox(c, id);
    line wx: num = box[1] as num;
    line wy: num = box[2] as num;
    line z: num = box[5] as num;
    line w: num = st["w"] as num;
    line h: num = st["h"] as num;
    line bandRows: num = st["bandRows"] as num;
    line uuids: list[str] = st["displays"] as list[str];
    repeat (line b to uuids.len()) {
        cpuGuard();
        line top: num = (b - 1) * bandRows;
        wmMove(uuids[b] as str, wmAt(wx, wy + top, w, num.min(bandRows, h - top), z));
    }
    if (st["role"] as str == "panel") {
        if (st.hasKey("fill")) {
            // Centred on x = 0 (text.vsh stretches it), just under the panel.
            line rows: num = h;
            if (st["panel"] as num == 0) {
                rows = wmCanvasH();
            }
            wmMove(st["fill"] as str, wmAt(-2, wy, 4, rows, num.max(0, z - 0.002)));
        }
        return;
    }
    wmMove(st["deco"] as str, wmAt(wx, wy - wmDecoH(), w, wmDecoH(), z));
    wmMove(st["grip"] as str, wmAt(wx + w - wmGrip(), wy + h - wmGrip(), wmGrip(), wmGrip(), z + 0.001));
}

/** Re-places every window (after the stacking order changes). */
function wmPlaceAll {
    line windows: list[str] = global "s.windows";
    for (line key of windows) {
        cpuGuard();
        line parts: list = (key as str).split(":");
        wmPlace(num.parse(parts[1] as str), num.parse(parts[2] as str));
    }
}

/** Removes window id's displays and title bar buffer (it stays in s.windows). */
function wmRemoveDisplays(c: num, id: num) {
    if (!var.exists(global "s.o %var(c) %var(id)")) {
        return;
    }
    line st: dict = global "s.o %var(c) %var(id)";
    if (!st.hasKey("displays")) {
        return;
    }
    line ents: list[str] = st["displays"] as list[str];
    line panel: num = 0;
    if (st["role"] as str == "panel") {
        panel = 1;
        if (st.hasKey("fill")) {
            ents.append(st["fill"] as str);
            st.remove("fill");
        }
    } else {
        ents.append(st["deco"] as str, st["grip"] as str);
    }
    for (line uid of ents) {
        cpuGuard();
        select entitiesByUUID(uid as str);
        selectedEntity.remove();
        select reset;
    }
    if (panel == 0) {
        kMemFree(st["decoFd"] as num);
    }
    st.remove("displays");
    global "s.o %var(c) %var(id)" = st;
}

/** Unmaps window id of c: its displays go and it leaves the stack. */
function wmUnmap(c: num, id: num) {
    if (!var.exists(global "s.o %var(c) %var(id)") || wlsGet(c, id, "mapped") as num == 0) {
        return;
    }
    wmRemoveDisplays(c, id);
    wlsPut(c, id, "mapped", 0);
    wlsPut(c, id, "dirty", list.create());
    line key: str = "%var(c):%var(id)";
    if (wlsGet(c, id, "role") as str == "panel") {
        global "s.panels".removeValue(key);
        if (global "s.ptr"["over"] as str == key) {
            global "s.ptr"["over"] = "";
        }
        return;
    }
    global "s.windows".removeValue(key);
    line handle: num = wlsGet(c, id, "handle") as num;
    global "s.handles".remove("%var(handle)");
    global "s.shellDirty" = 1;
    if (global "s.ptr"["over"] as str == key) {
        global "s.ptr"["over"] = "";
    }
    if (global "s.ptr"["drag"] as str == key) {
        global "s.ptr"["drag"] = "";
    }
    if (global "s.ptr"["resize"] as str == key) {
        wmEndResize();
    }
    if (global "s.focus" == key) {
        global "s.focus" = "";
        // Focus falls to the window below, if any.
        wmFocus(wmTopShown());
    }
    wmPlaceAll();
}

/**
 * The full-width strip (kind a8) under a background or taskbar panel: 4
 * glyphs a row, which text.vsh stretches across the window. The background
 * is its buffer's top-left pixel on every canvas row; the taskbar's ends are
 * the last pixel of each of its rows.
 */
function wmFillText(c: num, id: num): str {
    line buf: num = wlsGet(c, id, "buf") as num;
    line b: dict = global "s.o %var(c) %var(buf)" as dict;
    line fd: num = b["fd"] as num;
    line first: num = (b["offset"] as num) + 1;
    line w: num = b["width"] as num;
    line h: num = b["height"] as num;
    if (wlsGet(c, id, "panel") as num == 0) {
        line g: str = (global "k.mem %var(fd)"[first] as str).trim(1, 1).repeat(4);
        return wmMark("a8") + g + ("\n" + g).repeat(wmCanvasH() - 1);
    }
    line rows: list[str] = list.create() as list[str];
    repeat (line r to h) {
        rows.append((global "k.mem %var(fd)"[first + r - 1] as str).trim(w, w).repeat(4));
    }
    return wmMark("a8") + rows.join("\n");
}

/** The topmost window that is not minimized, or "". */
function wmTopShown(): str {
    line windows: list[str] = global "s.windows";
    line i: num = windows.len();
    while (i >= 1) {
        line key: str = windows[i] as str;
        line p: list = key.split(":");
        if (wlsGet(num.parse(p[1] as str), num.parse(p[2] as str), "min") as num == 0) {
            return key;
        }
        i -= 1;
    }
    return "";
}

/** The window key with shell handle `handle`, or "". */
function wmHandleKey(handle: num): str {
    if (global "s.handles".hasKey("%var(handle)")) {
        return global "s.handles"["%var(handle)"] as str;
    }
    return "";
}

/** Restores window key if minimized, raises it and gives it focus (taskbar and menu clicks). */
function wmActivate(key: str) {
    line p: list = key.split(":");
    line c: num = num.parse(p[1] as str);
    line id: num = num.parse(p[2] as str);
    if (wlsGet(c, id, "min") as num == 1) {
        wlsPut(c, id, "min", 0);
        wmPlace(c, id);
    }
    wmFocus(key);
    global "s.shellDirty" = 1;
}

/** Minimizes window key: it leaves the canvas and focus falls to the topmost window still shown. */
function wmMinimize(key: str) {
    line p: list = key.split(":");
    line c: num = num.parse(p[1] as str);
    line id: num = num.parse(p[2] as str);
    if (wlsGet(c, id, "min") as num == 1) {
        return;
    }
    wlsPut(c, id, "min", 1);
    wmPlace(c, id);
    if (global "s.ptr"["over"] as str == key) {
        global "s.ptr"["over"] = "";
    }
    if (global "s.focus" == key) {
        wmFocus(wmTopShown());
    }
    global "s.shellDirty" = 1;
}

/** The shell state of window key: 1 focused, plus 2 minimized. */
function wmShellState(key: str): num {
    line p: list = key.split(":");
    line state: num = 2 * (wlsGet(num.parse(p[1] as str), num.parse(p[2] as str), "min") as num);
    if (global "s.focus" == key) {
        state += 1;
    }
    return state;
}

/** Tells df_shell binding id of c about every window, then done. */
function wmShellSend(c: num, id: num) {
    line windows: list[str] = global "s.windows";
    for (line key of windows) {
        line p: list = (key as str).split(":");
        line wc: num = num.parse(p[1] as str);
        line wid: num = num.parse(p[2] as str);
        line st: dict = global "s.o %var(wc) %var(wid)" as dict;
        line title: str = st["title"] as str;
        if (title == "") {
            title = st["appId"] as str;
        }
        wlsSend(c, id, "df_shell", "window", [st["handle"], title, wmShellState(key as str)]);
    }
    wlsSend(c, id, "df_shell", "done", list.create());
}

/** Once a tick: if the windows changed, tells every shell binding about them and about the windows that closed. */
function wmShellSync {
    if (global "s.shellDirty" == 0) {
        return;
    }
    global "s.shellDirty" = 0;
    line now: list[num] = list.create() as list[num];
    for (line key of global "s.windows") {
        line p: list = (key as str).split(":");
        now.append(wlsGet(num.parse(p[1] as str), num.parse(p[2] as str), "handle") as num);
    }
    line sent: list[num] = global "s.shellSent";
    global "s.shellSent" = now;
    line shells: list[str] = global "s.shells";
    for (line sk of shells) {
        cpuGuard();
        line sp: list = (sk as str).split(":");
        line c: num = num.parse(sp[1] as str);
        line id: num = num.parse(sp[2] as str);
        for (line h of sent) {
            if (now.find(h as num) == 0) {
                wlsSend(c, id, "df_shell", "window_closed", [h]);
            }
        }
        wmShellSend(c, id);
    }
}

/** Draws window id's title bar: its title, and a close box on the right. Focused bars are blue. */
function wmDrawDeco(c: num, id: num) {
    line st: dict = global "s.o %var(c) %var(id)";
    line fd: num = st["decoFd"] as num;
    line w: num = st["w"] as num;
    line key: str = "%var(c):%var(id)";
    line bg: str = p15Color(0x606070);
    if (global "s.focus" == key) {
        bg = p15Color(0x2050C0);
    }
    line white: str = p15Color(0xFFFFFF);
    p15Fill(fd, 0, 0, w, wmDecoH(), bg);
    line title: str = st["title"] as str;
    if (title == "") {
        title = "window";
    }
    line maxChars: num = num.floor((w - 16) / 8);
    if (maxChars >= 1) {
        p15Text(fd, 2, 1, title.trim(1, maxChars), white, bg);
    }
    // Close box: a white x on red, 10 x 10 at the right end.
    line red: str = p15Color(0xE03020);
    p15Fill(fd, w - 10, 0, 10, wmDecoH(), red);
    p15Text(fd, w - 9, 1, "x", white, red);
    wlsPut(c, id, "decoDirty", 1);
}

/** The title changed: redraw the title bar of a mapped window. */
function wmTitleChanged(c: num, id: num) {
    if (wlsGet(c, id, "mapped") as num == 1) {
        wmDrawDeco(c, id);
        global "s.shellDirty" = 1;
    }
}

/** Gives keyboard focus to window key and raises it to the top. */
function wmFocus(key: str) {
    line old: str = global "s.focus";
    if (global "s.windows".find(key) > 0 && global "s.windows"[global "s.windows".len()] as str != key) {
        global "s.windows".removeValue(key);
        global "s.windows".append(key);
        wmPlaceAll();
    }
    if (old == key) {
        return;
    }
    global "s.focus" = key;
    global "s.shellDirty" = 1;
    if (old != "") {
        line op: list = old.split(":");
        line oc: num = num.parse(op[1] as str);
        line oid: num = num.parse(op[2] as str);
        if (var.exists(global "s.kbds %var(oc)")) {
            for (line kb of global "s.kbds %var(oc)" as list) {
                wlsSend(oc, kb as num, "wl_keyboard", "leave", [wlsSerial(), oid]);
            }
        }
        if (var.exists(global "s.o %var(oc) %var(oid)") && wlsGet(oc, oid, "mapped") as num == 1) {
            wmDrawDeco(oc, oid);
        }
    }
    if (key != "") {
        line np: list = key.split(":");
        line nc: num = num.parse(np[1] as str);
        line nid: num = num.parse(np[2] as str);
        for (line kb of global "s.kbds %var(nc)" as list) {
            wlsSend(nc, kb as num, "wl_keyboard", "enter", [wlsSerial(), nid, list.create()]);
        }
        wmDrawDeco(nc, nid);
    }
}

/** A client got a keyboard after its window took focus: tell it now. */
function wmKeyboardAdded(c: num, kb: num) {
    line key: str = global "s.focus";
    if (key != "") {
        line p: list = key.split(":");
        if (num.parse(p[1] as str) == c) {
            wlsSend(c, kb, "wl_keyboard", "enter", [wlsSerial(), num.parse(p[2] as str), list.create()]);
        }
    }
}

/** xdg_toplevel.move: the window follows the pointer until the next click. */
function wmBeginMove(c: num, id: num) {
    line key: str = "%var(c):%var(id)";
    if (global "s.ptr"["over"] as str == key) {
        global "s.ptr"["drag"] = key;
        global "s.ptr"["ddx"] = global "s.ptr"["sx"];
        global "s.ptr"["ddy"] = global "s.ptr"["sy"];
    }
}

/** The pointer: the input player's look as [x, y] canvas pixels from the centre (4 per degree, as text.vsh draws the cursor). */
function wmCursor(): list[num] {
    select playersByName(global "s.player");
    line view: loc = selected.location;
    select reset;
    line yaw: num = view.getCoordinate(coord="Yaw");
    while (yaw > 180) {
        yaw -= 360;
    }
    while (yaw < -180) {
        yaw += 360;
    }
    line pitch: num = view.getCoordinate(coord="Pitch");
    line x: num = num.clamp(num.round(yaw * 4), 0 - wmCanvasW() / 2, wmCanvasW() / 2);
    line y: num = num.clamp(num.round(pitch * 4), 0 - wmCanvasH() / 2, wmCanvasH() / 2);
    return [x, y];
}

/** The mapped panel with role `role`, or "". */
function wmPanelKey(role: num): str {
    for (line key of global "s.panels") {
        line p: list = (key as str).split(":");
        if (wlsGet(num.parse(p[1] as str), num.parse(p[2] as str), "panel") as num == role) {
            return key as str;
        }
    }
    return "";
}

/** [panel key, "panel", surface x, surface y] if canvas (x, y) is on the panel with role `role`, else []. */
function wmHitPanel(role: num, x: num, y: num): list {
    line key: str = wmPanelKey(role);
    if (key == "") {
        return list.create();
    }
    line p: list = key.split(":");
    line c: num = num.parse(p[1] as str);
    line id: num = num.parse(p[2] as str);
    line box: list[num] = wmBox(c, id);
    line bx: num = box[1] as num;
    line by: num = box[2] as num;
    line bw: num = (wlsGet(c, id, "w") as num) * (box[3] as num);
    line bh: num = (wlsGet(c, id, "h") as num) * (box[4] as num);
    if (x >= bx && x < bx + bw && y >= by && y < by + bh) {
        return [key, "panel", num.floor((x - bx) / (box[3] as num)), num.floor((y - by) / (box[4] as num))];
    }
    return list.create();
}

/**
 * What canvas point (x, y) is on, topmost first: [surface key, part, surface x, surface y].
 * part is "panel" (the menu, the taskbar, or under every window the
 * background) or a window's "body", "grip", "title" or "close"; the key is
 * "" when nothing is there.
 */
function wmHit(x: num, y: num): list {
    for (line role of [2, 1]) {
        line ph: list = wmHitPanel(role as num, x, y);
        if (ph.len() > 0) {
            return ph;
        }
    }
    line windows: list[str] = global "s.windows";
    line i: num = windows.len();
    while (i >= 1) {
        line key: str = windows[i] as str;
        line p: list = key.split(":");
        line hc: num = num.parse(p[1] as str);
        line hid: num = num.parse(p[2] as str);
        line st: dict = global "s.o %var(hc) %var(hid)" as dict;
        if (st["min"] as num == 1) {
            // Minimized: off the canvas.
            i -= 1;
            continue;
        }
        line wx: num = st["wx"] as num;
        line wy: num = st["wy"] as num;
        line w: num = st["w"] as num;
        line h: num = st["h"] as num;
        if (x >= wx && x < wx + w && y >= wy && y < wy + h) {
            if (x >= wx + w - wmGrip() && y >= wy + h - wmGrip()) {
                return [key, "grip", x - wx, y - wy];
            }
            return [key, "body", x - wx, y - wy];
        }
        if (x >= wx && x < wx + w && y >= wy - wmDecoH() && y < wy) {
            if (x >= wx + w - 10) {
                return [key, "close", 0, 0];
            }
            return [key, "title", x - wx, y - wy];
        }
        i -= 1;
    }
    line bh: list = wmHitPanel(0, x, y);
    if (bh.len() > 0) {
        return bh;
    }
    return ["", "", 0, 0];
}

/** Sends a pointer event to every wl_pointer of window key's client. */
function wmPointerEvent(key: str, name: str, values: list) {
    line p: list = key.split(":");
    line c: num = num.parse(p[1] as str);
    if (!var.exists(global "s.ptrs %var(c)")) {
        return;
    }
    for (line ptr of global "s.ptrs %var(c)") {
        wlsSend(c, ptr as num, "wl_pointer", name, values);
    }
}

/** One tick of input: keeps the player seated, then pointer motion, enter and leave, drags, resizes, clicks and keys. */
function wmInput {
    select playersByName(global "s.player");
    if (!selected.isRidingEntity()) {
        selected.rideEntity(global "s.desk"["seat"] as str);
    }
    select reset;
    line ptr: dict = global "s.ptr";
    line cur: list[num] = wmCursor();
    line x: num = cur[1] as num;
    line y: num = cur[2] as num;
    line moved: num = 0;
    if (x != ptr["x"] as num || y != ptr["y"] as num) {
        moved = 1;
    }
    ptr["x"] = x;
    ptr["y"] = y;
    line drag: str = ptr["drag"] as str;
    if (drag != "" && moved == 1) {
        line dp: list = drag.split(":");
        line dc: num = num.parse(dp[1] as str);
        line did: num = num.parse(dp[2] as str);
        wlsPut(dc, did, "wx", x - (ptr["ddx"] as num));
        wlsPut(dc, did, "wy", y - (ptr["ddy"] as num));
        wmPlace(dc, did);
    }
    global "s.ptr" = ptr;
    if (ptr["resize"] as str != "" && moved == 1) {
        wmResizeTrack(x, y);
    }
    line hit: list = wmHit(x, y);
    line over: str = "";
    if (hit[2] as str == "body" || hit[2] as str == "panel") {
        over = hit[1] as str;
    }
    line old: str = global "s.ptr"["over"] as str;
    if (over != old) {
        if (old != "") {
            wmPointerEvent(old, "leave", [wlsSerial(), num.parse(old.split(":")[2] as str)]);
        }
        if (over != "") {
            wmPointerEvent(over, "enter", [wlsSerial(), num.parse(over.split(":")[2] as str), hit[3], hit[4]]);
        }
    } else if (over != "" && moved == 1) {
        wmPointerEvent(over, "motion", [wlsTime(), hit[3], hit[4]]);
    }
    global "s.ptr"["over"] = over;
    global "s.ptr"["sx"] = hit[3];
    global "s.ptr"["sy"] = hit[4];
    if (global "s.clicks".len() > 0) {
        line clicks: list[num] = global "s.clicks";
        global "s.clicks" = list.create() as list[num];
        for (line button of clicks) {
            wmClick(button as num, hit);
        }
    }
    if (global "s.keys".len() > 0) {
        line keys: list = global "s.keys";
        global "s.keys" = list.create();
        for (line k of keys) {
            line kp: list = k as list;
            wmKey(kp[1] as num, kp[2] as num);
        }
    }
}

/** A click with evdev button `button` on what `hit` (from wmHit) found. */
function wmClick(button: num, hit: list) {
    if (global "s.ptr"["drag"] as str != "") {
        // A click drops a dragged window.
        global "s.ptr"["drag"] = "";
        return;
    }
    if (global "s.ptr"["resize"] as str != "") {
        // A click ends a resize: the client is asked to take the new size.
        wmApplyResize();
        return;
    }
    line key: str = hit[1] as str;
    if (key == "") {
        return;
    }
    line part: str = hit[2] as str;
    if (part != "panel") {
        // Panels never take keyboard focus.
        wmFocus(key);
    }
    line p: list = key.split(":");
    line c: num = num.parse(p[1] as str);
    line id: num = num.parse(p[2] as str);
    if (part == "close") {
        wlsSend(c, wlsGet(c, id, "top") as num, "xdg_toplevel", "close", list.create());
    } else if (part == "title") {
        global "s.ptr"["drag"] = key;
        global "s.ptr"["ddx"] = hit[3];
        global "s.ptr"["ddy"] = hit[4];
    } else if (part == "grip") {
        wmBeginResize(key);
    } else {
        // DF reports clicks, not presses, so each is a press and a release.
        line t: num = wlsTime();
        wmPointerEvent(key, "button", [wlsSerial(), t, button, 1]);
        wmPointerEvent(key, "button", [wlsSerial(), t, button, 0]);
    }
}

/** Starts resizing window key: an outline follows the pointer until the next click. */
function wmBeginResize(key: str) {
    line p: list = key.split(":");
    line c: num = num.parse(p[1] as str);
    line id: num = num.parse(p[2] as str);
    global "s.ptr"["resize"] = key;
    global "s.ptr"["rw"] = 0;
    global "s.ptr"["rh"] = 0;
    wmResizeTrack(global "s.ptr"["x"] as num, global "s.ptr"["y"] as num);
}

/** The size window `resize` would take with its bottom-right corner at canvas (x, y): even width, within the limits. */
function wmResizeSize(x: num, y: num): list[num] {
    line key: str = global "s.ptr"["resize"] as str;
    line p: list = key.split(":");
    line c: num = num.parse(p[1] as str);
    line id: num = num.parse(p[2] as str);
    line wx: num = wlsGet(c, id, "wx") as num;
    line wy: num = wlsGet(c, id, "wy") as num;
    line w: num = num.clamp(x - wx + 1, wmMinW(), 600);
    w = num.floor(w / 2) * 2;
    line h: num = num.clamp(y - wy + 1, wmMinH(), 330);
    return [w, h];
}

/** Moves the resize outline to the size the pointer at canvas (x, y) gives. */
function wmResizeTrack(x: num, y: num) {
    line size: list[num] = wmResizeSize(x, y);
    line w: num = size[1] as num;
    line h: num = size[2] as num;
    if (w == global "s.ptr"["rw"] as num && h == global "s.ptr"["rh"] as num) {
        return;
    }
    global "s.ptr"["rw"] = w;
    global "s.ptr"["rh"] = h;
    line key: str = global "s.ptr"["resize"] as str;
    line p: list = key.split(":");
    line c: num = num.parse(p[1] as str);
    line id: num = num.parse(p[2] as str);
    line wx: num = wlsGet(c, id, "wx") as num;
    line wy: num = wlsGet(c, id, "wy") as num;
    line edge: str = p15Color(0xFFD040);
    line across: str = wmMark("a6") + edge.repeat(w);
    line down: str = wmMark("a6") + edge + ("\n" + edge).repeat(h - 1);
    line outline: list[str] = global "s.desk"["outline"] as list[str];
    wmSetText(outline[1] as str, across);
    wmSetText(outline[2] as str, across);
    wmSetText(outline[3] as str, down);
    wmSetText(outline[4] as str, down);
    wmMove(outline[1] as str, wmAt(wx, wy, w, 1, 0.1));
    wmMove(outline[2] as str, wmAt(wx, wy + h - 1, w, 1, 0.1));
    wmMove(outline[3] as str, wmAt(wx, wy, 1, h, 0.1));
    wmMove(outline[4] as str, wmAt(wx + w - 1, wy, 1, h, 0.1));
}

/** Hides the resize outline and leaves resize mode. */
function wmEndResize {
    global "s.ptr"["resize"] = "";
    for (line uid of global "s.desk"["outline"] as list[str]) {
        wmSetText(uid as str, " ");
    }
}

/** Asks the resized window's client to take the outline's size (xdg_toplevel.configure); its next buffer of that size remaps it. */
function wmApplyResize {
    line key: str = global "s.ptr"["resize"] as str;
    line w: num = global "s.ptr"["rw"] as num;
    line h: num = global "s.ptr"["rh"] as num;
    wmEndResize();
    wmResizeTo(key, w, h);
}

/** Asks window key's client to resize to w x h. */
function wmResizeTo(key: str, w: num, h: num) {
    line p: list = key.split(":");
    line c: num = num.parse(p[1] as str);
    line id: num = num.parse(p[2] as str);
    if (!var.exists(global "s.o %var(c) %var(id)") || wlsGet(c, id, "mapped") as num == 0) {
        return;
    }
    line states: list[num] = list.create() as list[num];
    if (global "s.focus" == key) {
        // xdg_toplevel.state.activated
        states.append(4);
    }
    wlsSend(c, wlsGet(c, id, "top") as num, "xdg_toplevel", "configure", [w, h, states]);
    wlsSend(c, wlsGet(c, id, "xdg") as num, "xdg_surface", "configure", [wlsSerial()]);
}

/** Types evdev key `code` (with shift held if shift is 1) into the focused window. */
function wmKey(code: num, shift: num) {
    line key: str = global "s.focus";
    if (key == "") {
        return;
    }
    line c: num = num.parse(key.split(":")[1] as str);
    if (!var.exists(global "s.kbds %var(c)")) {
        return;
    }
    line t: num = wlsTime();
    for (line kb of global "s.kbds %var(c)") {
        line k: num = kb as num;
        if (shift == 1) {
            wlsSend(c, k, "wl_keyboard", "modifiers", [wlsSerial(), 1, 0, 0, 0]);
        }
        wlsSend(c, k, "wl_keyboard", "key", [wlsSerial(), t, code, 1]);
        wlsSend(c, k, "wl_keyboard", "key", [wlsSerial(), t, code, 0]);
        if (shift == 1) {
            wlsSend(c, k, "wl_keyboard", "modifiers", [wlsSerial(), 0, 0, 0, 0]);
        }
    }
}

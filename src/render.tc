// render.tc: puts window pixels on screen. A window is a stack of canvas
// text displays ("bands", wm.tc), one text line per pixel row. p15 buffers
// already hold glyph rows, so a band is the canvas mark and its rows joined
// (README, Data path benchmarks). The tagged formats (argb8888, xrgb8888,
// rgb332) carry pixel data in the text color, which the canvas mark needs,
// so their windows show grey. A commit marks the bands its damage touches;
// wmRender redraws marked bands within a budget per tick, and once a window
// has none left its commit is presented: the buffer is released and its
// frame callbacks run.

/** Canvas text for rows y0..y1 (0-based) of p15 image fd whose first row is entry `first` (1-based). */
function wmBandTextP15(fd: num, first: num, y0: num, y1: num): str {
    line rows: list[str] = global "k.mem %var(fd)".trim(first + y0, first + y1) as list[str];
    return wmMark("a5") + rows.join("\n");
}

/** Canvas text of `rows` rows of w grey pixels: the stand-in for buffers the canvas can't show. */
function wmBandTextGrey(w: num, rows: num): str {
    line row: str = p15Color(0x808080).repeat(w);
    return wmMark("a5") + row + ("\n" + row).repeat(rows - 1);
}

/**
 * Budget units for redrawing `glyphs` glyphs: DF builds a band almost for
 * free, but the client re-processes each glyph sent (3-4 us), so 1500 units
 * (7500 glyphs) a tick is about what it absorbs at 60 FPS.
 */
function wmCost(glyphs: num): num {
    return glyphs / 5;
}

/** Redraws marked bands and title bars of windows and panels, at most about `budget` units (wmCost) this tick. */
function wmRender(budget: num) {
    line left: num = budget;
    line windows: list[str] = global "s.windows";
    windows.appendList(global "s.panels");
    for (line key of windows) {
        cpuGuard();
        line p: list = (key as str).split(":");
        line c: num = num.parse(p[1] as str);
        line id: num = num.parse(p[2] as str);
        if (var.exists(global "s.o %var(c) %var(id)") && wlsGet(c, id, "mapped") as num == 1) {
            line st: dict = global "s.o %var(c) %var(id)";
            if (st["decoDirty"] as num == 1 && left > 0) {
                wmSetText(st["deco"] as str, wmBandTextP15(st["decoFd"] as num, 1, 0, wmDecoH() - 1));
                wlsPut(c, id, "decoDirty", 0);
                left -= wmCost((st["w"] as num) * wmDecoH());
            }
            line dirty: list[num] = st["dirty"] as list[num];
            if (dirty.len() > 0 && left > 0) {
                line before: num = dirty.len();
                dirty = wmRenderBands(c, id, dirty, left);
                wlsPut(c, id, "dirty", dirty);
                left -= wmCost((before - dirty.len()) * (st["w"] as num) * (st["bandRows"] as num));
            }
            if (dirty.len() == 0 && st["present"] as num == 1) {
                wlsPut(c, id, "present", 0);
                wlsPresented(c, id);
            }
        }
    }
}

/** Renders bands from `dirty` until about `budget` units are spent; returns the bands still marked. */
function wmRenderBands(c: num, id: num, dirty: list[num], budget: num): list[num] {
    line st: dict = global "s.o %var(c) %var(id)";
    line buf: num = st["buf"] as num;
    if (wlsIface(c, buf) != "wl_buffer") {
        return list.create() as list[num];
    }
    line b: dict = global "s.o %var(c) %var(buf)" as dict;
    line fd: num = b["fd"] as num;
    line w: num = st["w"] as num;
    line h: num = st["h"] as num;
    line bandRows: num = st["bandRows"] as num;
    line p15: num = 0;
    if (b["format"] as num == p15Format()) {
        p15 = 1;
    }
    line uuids: list[str] = st["displays"] as list[str];
    line left: num = budget;
    while (dirty.len() > 0 && left > 0) {
        cpuGuard();
        line band: num = dirty[1] as num;
        dirty.remove(1);
        line y0: num = (band - 1) * bandRows;
        line y1: num = num.min(band * bandRows, h) - 1;
        if (p15 == 1) {
            // p15: offset is the buffer's first row in the pool.
            wmSetText(uuids[band] as str, wmBandTextP15(fd, (b["offset"] as num) + 1, y0, y1));
        } else {
            wmSetText(uuids[band] as str, wmBandTextGrey(w, y1 - y0 + 1));
        }
        left -= wmCost(w * (y1 - y0 + 1));
    }
    return dirty;
}
